# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)

# 쿠팡 파트너스 최종 승인 후 파트너스 사이트 > 파트너스 API 에서 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 사이트 주소 (Cloudflare Pages 주소 또는 구매한 도메인). 사이트맵과 검색 등록에 쓰입니다.
SITE_URL=https://golf-price.pages.dev

# 주간 분석 (내 PC에서 직접 돌릴 때만. 자동 실행은 GitHub Secrets 에 같은 이름으로 등록)
# 서치콘솔 서비스 계정 JSON 키 전체를 한 줄로, 속성 주소
GSC_SERVICE_ACCOUNT=
GSC_SITE=https://golf-price.pages.dev/
# 클릭 추적 집계 (Cloudflare API 토큰: D1 읽기 권한)
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
